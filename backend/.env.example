PORT=5000
# REQUIRED. Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
# The server refuses to start in production (NODE_ENV=production or on Vercel) without it.
JWT_SECRET=replace_with_a_long_random_secret
NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Optional. Without it the AI endpoints return deterministic, chart-based fallback text.
OPENAI_API_KEY=your_openai_api_key_here
# Optional. Set to "false" to skip seeding the demo Pandit account (rishiraj@astroai.com / pandit123).
SEED_DEMO_PANDIT=true

# --- Games (/api/game) -------------------------------------------------------
# Wallet credits are real value (they pay for Pandit consultations), so game rewards are small,
# claimable once per account, and can be switched off. With "false" every reward is XP only.
GAME_WALLET_REWARDS=true
# Wallet credit (INR) for completing one row of 9 Nakshatra cards (3 rows). 0 = XP instead. Max 500.
GAME_SET_REWARD_AMOUNT=11
# Wallet credit (INR) for collecting all 27 Nakshatra cards. 0 = XP instead. Max 1000.
GAME_FULL_SET_REWARD_AMOUNT=51
# XP for reaching square 100 in Moksha Patam (family players earn half).
GAME_MOKSHA_WIN_XP=200
# Optional one-time wallet credit (INR) for the first Moksha win. Default 0 = XP and a rare card only.
GAME_MOKSHA_WIN_WALLET=0
